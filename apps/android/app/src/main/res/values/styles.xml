<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Litigo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#0a0a0a</item>
        <item name="colorPrimaryVariant">#1f2937</item>
        <item name="colorOnPrimary">#fafafa</item>
        <item name="colorSecondary">#b45309</item>
        <item name="colorSecondaryVariant">#92400e</item>
        <item name="colorOnSecondary">#ffffff</item>
        <item name="android:statusBarColor">#fafafa</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#ffffff</item>
        <item name="android:windowBackground">#fafafa</item>
        <item name="materialCardViewStyle">@style/Widget.Litigo.Card</item>
    </style>

    <style name="Widget.Litigo.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">1A0A0A0A</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@android:color/white</item>
    </style>

    <style name="Widget.Litigo.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>
</resources>
