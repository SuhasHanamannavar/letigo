{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Litigo",
  "version": "1.0.0",
  "identifier": "ai.litigo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "withGlobalTauri": true
  },
  "app": {
    "windows": [
      {
        "title": "Litigo",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["../../assets/**"]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "identifier": "ai.litigo.app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "AI Rule Enforcement",
    "longDescription": "Litigo lets you define rules once and enforce them across AI conversations. Runs locally, respects your privacy.",
    "copyright": "© 2026 Litigo",
    "exceptionDomain": "",
    "allowList": {
      "all": false,
      "default": {
        "scope": "allow",
        "features": ["fs", "os", "path", "process", "shell", "window"]
      }
    },
    "externalBin": [],
    "copyright": "© 2026 Litigo",
    "category": "Productivity",
    "shortDescription": "AI Rule Enforcement",
    "longDescription": "Define your AI rules once. Litigo keeps them enforced across the chatbots you use.",
    "resources": [],
    "deb": {
      "depends": []
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "desktop": {
        "Name": "Litigo",
        "Comment": "AI Rule Enforcement",
        "Categories": "Utility;Productivity;"
      }
    }
  },
  "plugins": {}
}
