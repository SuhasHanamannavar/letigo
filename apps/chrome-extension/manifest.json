{
  "manifest_version": 3,
  "name": "Litigo — AI Rule Enforcement",
  "version": "1.0.0",
  "description": "Define rules once. Litigo enforces them across ChatGPT, Claude, Gemini, and other chatbots. Runs locally, respects your privacy.",
  "default_locale": "en",

  "permissions": ["storage", "activeTab", "scripting"],

  "host_permissions": [
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://grok.x.ai/*",
    "https://x.com/i/grok/*"
  ],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon-32.svg",
      "48": "icons/icon-48.svg",
      "128": "icons/icon-128.svg"
    },
    "default_title": "Litigo"
  },

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://grok.x.ai/*",
        "https://x.com/i/grok/*"
      ],
      "js": ["src/content/content-script.js"],
      "css": ["src/content/litigo-inject.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "options_page": "src/options/options.html",

  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-32.svg",
    "48": "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  },

  "web_accessible_resources": [
    {
      "resources": ["src/content/litigo-inject.css", "icons/*.svg"],
      "matches": [
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://grok.x.ai/*",
        "https://x.com/*"
      ]
    }
  ]
}
