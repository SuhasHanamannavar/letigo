{
  "manifest_version": 3,
  "name": "Litigo — AI Rule Enforcement",
  "version": "1.0.0",
  "description": "Define rules once. Litigo enforces them across ChatGPT, Claude, Gemini, and other chatbots. Runs locally, respects your privacy.",
  "default_locale": "en",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://grok.x.ai/*",
    "https://x.com/i/grok/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Litigo"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://grok.x.ai/*",
        "https://x.com/i/grok/*"
      ],
      "js": ["moss.js", "src/content/content-script.js"],
      "css": ["src/content/litigo-inject.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/litigo-inject.css", "icons/*.png", "moss.wasm", "moss.js"],
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://grok.x.ai/*",
        "https://x.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
