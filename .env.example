# Litigo Environment Variables Template
# Copy this file to .env and fill in values as needed
# NEVER commit .env to version control

# ─── Application ─────────────────────────────────────────────────

# Public canonical URL of the Litigo website
NEXT_PUBLIC_APP_URL=https://litigo.example.com

# ─── Authentication (Optional — for cloud features only) ────────

# Auth service secret key (e.g., Auth0, JWT signing key)
AUTH_SECRET=

# OAuth provider credentials (if using social login)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ─── Database (Optional — for auth/subscription only) ───────────

# PostgreSQL connection string
# Litigo does NOT store conversation content or rule evaluation results
DATABASE_URL=postgresql://user:password@localhost:5432/litigo

# ─── Payment Processing (Optional) ──────────────────────────────

# Stripe API keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Product price IDs from Stripe dashboard
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# ─── Cross-Device Sync (Optional — E2EE) ────────────────────────

# Master key for wrapping sync encryption keys
# This key encrypts user keys at rest — it does NOT decrypt user data
SYNC_MASTER_KEY=

# Object storage for sync ciphertext blobs
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=litigo-sync
S3_REGION=

# ─── Email (Optional) ───────────────────────────────────────────

# Transactional email provider
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@litigo.example.com
EMAIL_FROM_NAME=Litigo

# ─── Analytics (Optional — opt-in only) ─────────────────────────

# If implementing optional telemetry
ANALYTICS_ENDPOINT=
ANALYTICS_API_KEY=

# ─── Development ────────────────────────────────────────────────

# Enable debug logging
DEBUG=false

# Wasm engine path override (for local Moss engine development)
MOSS_WASM_PATH=

# Chrome extension hot reload port
EXTENSION_DEV_PORT=5173
